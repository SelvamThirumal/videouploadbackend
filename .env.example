# FASTBATCH Server Environment Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/video_merger
CLIENT_URL=http://localhost:5173

# 1 TB Storage Configuration
# 1 TB = 1024 GB = 1048576 MB
MAX_BATCH_SIZE_GB=1024
MAX_BATCH_SIZE_MB=1048576
MAX_FILES_PER_BATCH=10000

FILE_RETENTION_MINUTES=10
TEMP_FILE_RETENTION_MINUTES=60
TEMP_DIR=./temp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_CONCURRENT_MERGES=2
